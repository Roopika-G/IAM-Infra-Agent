# Runtime configuration for the agent, the detector, the search scripts and the UI backend.
# Copy to .env (or run ./create-env.sh). .env is gitignored; never commit it.

# The only secret that exists nowhere else. Put your key here.
ANTHROPIC_API_KEY=

# Model the agent uses.
AGENT_MODEL=claude-haiku-5-5

# Send the agent's traces to Phoenix (a local viewer for LLM runs; ./start-all.sh starts it).
# Remove or blank this line to turn tracing off.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# kubectl context of the kind cluster.
KUBE_CONTEXT=kind-self-healing-iam

# These two are filled in by ./create-env.sh from the cluster's Kubernetes Secrets
# (postgres-credentials, pingfederate-license). The cluster is the source of truth;
# re-run the script if the cluster is rebuilt.
AGENT_DB_DSN=
PF_ADMIN_PASSWORD=

# Shared secret that lets the worker call the helm_deploy server (deploy after a PR is merged).
# ./create-env.sh generates one. Without it, merged PRs are not deployed.
HELM_DEPLOY_TOKEN=
