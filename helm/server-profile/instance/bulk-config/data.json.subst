{
  "metadata": {
    "pfVersion": "13.1.1.0"
  },
  "operations": [
    {
      "resourceType": "/license/agreement",
      "operationType": "SAVE",
      "items": [
        {
          "licenseAgreementUrl": "https://localhost:9999/pf-admin-api/license-agreement",
          "accepted": true
        }
      ]
    },
    {
      "resourceType": "/dataStores",
      "operationType": "SAVE",
      "items": [
        {
          "type": "JDBC",
          "id": "PostgresPfApp",
          "name": "Postgres (pf_app)",
          "driverClass": "org.postgresql.Driver",
          "connectionUrl": "${POSTGRES_JDBC_URL}",
          "connectionUrlTags": [
            {
              "connectionUrl": "${POSTGRES_JDBC_URL}",
              "defaultSource": true
            }
          ],
          "userName": "${POSTGRES_JDBC_USERNAME}",
          "password": "${POSTGRES_JDBC_PASSWORD}",
          "maskAttributeValues": false,
          "allowMultiValueAttributes": false,
          "minPoolSize": 10,
          "maxPoolSize": 100,
          "blockingTimeout": 5000,
          "idleTimeout": 5
        }
      ]
    }
  ]
}
