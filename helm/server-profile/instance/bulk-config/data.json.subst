{
    "metadata": {"pfVersion": "13.1.0.0"},
    "operations": [
        {
            "operationType": "SAVE",
            "items": [
                {
                    "maskAttributeValues": false,
                    "connectionUrlTags": [{
                        "connectionUrl": "jdbc:hsqldb:${pf.server.data.dir}${/}hypersonic${/}ProvisionerDefaultDB;hsqldb.lock_file=false",
