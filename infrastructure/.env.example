# Copy to .env, fill in the real path, then `source .env` before running terraform.
# .env is gitignored — .env.example is the committed template.

# Absolute path to your PingFederate license file.
export TF_VAR_pingfederate_license_path="/absolute/path/to/pingfederate.lic"

# Absolute path to the pf.jwk exported with the matching data.json.
export TF_VAR_pingfederate_master_key_path="/absolute/path/to/pf.jwk"
